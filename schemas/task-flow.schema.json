{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://journey.local/schemas/task-flow.schema.json",
  "title": "Task Flow Document",
  "description": "A task flow extracted from a WebVTT transcript. `flow` is what Claude produces (see $defs/flow, used as the structured-output schema); everything else is added by the API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "extraction",
    "cues",
    "flow"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "cueCount",
        "durationMs"
      ],
      "properties": {
        "path": {
          "description": "Fully qualified path to the source VTT file, resolved when the flow was extracted.",
          "type": "string"
        },
        "sha256": {
          "description": "Hash of the VTT file at extraction time, to detect later changes.",
          "type": "string"
        },
        "cueCount": {
          "type": "integer"
        },
        "durationMs": {
          "type": "integer"
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "provider",
        "client",
        "model",
        "createdAt",
        "options"
      ],
      "properties": {
        "route": {
          "description": "How the flow was extracted (D-026): provider = Journey called a model profile; mcp = an MCP client ran its own model.",
          "enum": [
            "provider",
            "mcp"
          ]
        },
        "provider": {
          "description": "Model provider (provider route), e.g. anthropic; null on the MCP route.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "client": {
          "description": "MCP client name and version as reported by the connection (MCP route); null on the provider route.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "description": "Model that served the final request (provider route), or the model reported by the MCP client, or \"unknown\".",
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mainSpeaker",
            "interviewers"
          ],
          "properties": {
            "mainSpeaker": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "interviewers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "cues": {
      "description": "Timing index for every cue, so evidence can be resolved to timestamps without the VTT. Text is deliberately not stored.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "startMs",
          "endMs",
          "speaker"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "startMs": {
            "type": "integer"
          },
          "endMs": {
            "type": "integer"
          },
          "speaker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "flow": {
      "$ref": "#/$defs/flow"
    }
  },
  "$defs": {
    "evidence": {
      "description": "IDs of the transcript cues that support this element. Must not be empty.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "likert": {
      "description": "5-point Likert value. Labels are derived from the value by measure type, not stored.",
      "anyOf": [
        {
          "enum": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "measure": {
      "description": "A frequency or difficulty measure. `basis`: scale = participant gave a scale value (spontaneously or when asked); inferred = value mapped from free text by the extractor; text = free text only, no value. `threshold`: the participant's binary judgement relative to their own (often unstated) tolerance; above = a frustration signal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "basis",
        "threshold",
        "text",
        "evidence"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/likert"
        },
        "basis": {
          "enum": [
            "scale",
            "inferred",
            "text"
          ]
        },
        "threshold": {
          "anyOf": [
            {
              "enum": [
                "above",
                "below"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "duration": {
      "description": "Time as described by the participant, not measured from the recording.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minutes",
        "text",
        "evidence"
      ],
      "properties": {
        "minutes": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "text",
        "evidence"
      ],
      "properties": {
        "count": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeOnTask",
        "attempts"
      ],
      "properties": {
        "timeOnTask": {
          "anyOf": [
            {
              "$ref": "#/$defs/duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempts": {
          "anyOf": [
            {
              "$ref": "#/$defs/attempts"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "namedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "evidence"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "participant": {
      "description": "A VTT speaker label and how it was interpreted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speakerLabel",
        "role",
        "isMainSpeaker",
        "sharedConnection",
        "people"
      ],
      "properties": {
        "speakerLabel": {
          "type": "string"
        },
        "role": {
          "enum": [
            "interviewer",
            "participant",
            "other"
          ]
        },
        "isMainSpeaker": {
          "type": "boolean"
        },
        "sharedConnection": {
          "type": "boolean"
        },
        "people": {
          "description": "Names or descriptions of people speaking under this label, when distinguishable.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "speakerLabels",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "person",
            "role",
            "team",
            "system",
            "organisation"
          ]
        },
        "speakerLabels": {
          "description": "VTT speaker labels that are this actor. Empty for actors who are only talked about.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actorId",
        "kind",
        "label",
        "description",
        "outcome",
        "returnToStepId",
        "frequency",
        "difficulty",
        "attributes",
        "states",
        "metrics",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "actorId": {
          "type": "string"
        },
        "kind": {
          "description": "action = something an actor does; decision = a point where the path depends on a condition (label is the question); outcome = how the task ends; return = (error flows only) the error flow ends by continuing the main flow at returnToStepId.",
          "enum": [
            "action",
            "decision",
            "outcome",
            "return"
          ]
        },
        "label": {
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "description": "Required when kind is outcome, otherwise null.",
          "anyOf": [
            {
              "enum": [
                "success",
                "failure",
                "abandonment"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "returnToStepId": {
          "description": "Required when kind is return: the main-flow step the task continues at. Otherwise null.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "frequency": {
          "description": "How often this step happens; on an outcome, how often the task ends this way.",
          "anyOf": [
            {
              "$ref": "#/$defs/measure"
            },
            {
              "type": "null"
            }
          ]
        },
        "difficulty": {
          "anyOf": [
            {
              "$ref": "#/$defs/measure"
            },
            {
              "type": "null"
            }
          ]
        },
        "attributes": {
          "description": "Other properties of the step (e.g. tool used: spreadsheet).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedValue"
          }
        },
        "states": {
          "description": "States of things at this step (e.g. order: on hold).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedValue"
          }
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "condition",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "condition": {
          "description": "Branch label. Required on transitions leaving a decision, otherwise usually null.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "loop": {
      "description": "A repeated span of steps (D-019). Body = every step on a path from firstStepId to lastStepId. repeat: count known (number) or varying (text only); no decision, no back transition. iterate: lastStepId is the decision that checks the criteria; its back transition to firstStepId is labelled `fail`, its exit labelled `pass`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "firstStepId",
        "lastStepId",
        "count",
        "pass",
        "fail",
        "iterations",
        "limit",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "repeat",
            "iterate"
          ]
        },
        "firstStepId": {
          "type": "string"
        },
        "lastStepId": {
          "type": "string"
        },
        "count": {
          "description": "repeat only: how many times. value is null when the count varies (e.g. for each receipt).",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "text",
                "evidence"
              ],
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "text": {
                  "type": "string"
                },
                "evidence": {
                  "$ref": "#/$defs/evidence"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "pass": {
          "description": "iterate only: condition label of the decision branch that leaves the loop.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fail": {
          "description": "iterate only: condition label of the decision branch that loops back.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "iterations": {
          "description": "iterate only: typical number of passes as stated.",
          "anyOf": [
            {
              "$ref": "#/$defs/attempts"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "description": "iterate only: the most tries before giving up; running out triggers errorFlowId from the decision step.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "count",
                "text",
                "errorFlowId",
                "evidence"
              ],
              "properties": {
                "count": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "text": {
                  "type": "string"
                },
                "errorFlowId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence": {
                  "$ref": "#/$defs/evidence"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "errorTrigger": {
      "description": "Where and why the main flow links out to an error flow.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromStepId",
        "condition",
        "frequency",
        "evidence"
      ],
      "properties": {
        "fromStepId": {
          "description": "Main-flow step where the error occurs.",
          "type": "string"
        },
        "condition": {
          "description": "What goes wrong, e.g. Card declined.",
          "type": "string"
        },
        "frequency": {
          "description": "How often this error happens.",
          "anyOf": [
            {
              "$ref": "#/$defs/measure"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "errorFlow": {
      "description": "A separate flow followed when something goes wrong. Rendered as its own diagram. Ends in outcomes and/or return steps.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "triggers",
        "startStepId",
        "steps",
        "transitions",
        "loops",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/errorTrigger"
          }
        },
        "startStepId": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "loops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loop"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targetId",
        "kind",
        "text",
        "speaker",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "targetId": {
          "description": "ID of the step, transition, actor, error flow or loop this note is about (in any flow); null for the whole task.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "description": "alternativeView = a participant's different approach or view (D-004); correction = a participant revised or contradicted their own account, and the flow uses the corrected version (D-016).",
          "enum": [
            "note",
            "hesitation",
            "workaround",
            "opinion",
            "quote",
            "alternativeView",
            "correction"
          ]
        },
        "text": {
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "flow": {
      "description": "The task flow as extracted by Claude. Used as the structured-output schema.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "goal",
        "frequency",
        "difficulty",
        "participants",
        "actors",
        "startStepId",
        "steps",
        "transitions",
        "errorFlows",
        "loops",
        "metrics",
        "annotations"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "goal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "evidence"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "frequency": {
          "description": "How often the participant does the whole task.",
          "anyOf": [
            {
              "$ref": "#/$defs/measure"
            },
            {
              "type": "null"
            }
          ]
        },
        "difficulty": {
          "description": "How hard the participant finds the whole task.",
          "anyOf": [
            {
              "$ref": "#/$defs/measure"
            },
            {
              "type": "null"
            }
          ]
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/participant"
          }
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actor"
          }
        },
        "startStepId": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "errorFlows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/errorFlow"
          }
        },
        "loops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loop"
          }
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        }
      }
    }
  }
}
